{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Why Australians Take Part in Nature Activities (2011-2012)",
    "subtitle": "Each bar shows how that state's participants are split across reasons (sums to 100%)",
    "anchor": "middle",
    "frame": "bounds",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "offset": 16,
    "subtitlePadding": 6,
    "subtitleColor": "#555"
  },

  "data": {
    "url": "datasets/activity_reason.csv",
    "format": { "type": "csv" }
  },

  "width": 550,
  "height": 350,
  "padding": { "left": 15, "right": 15, "top": 0, "bottom": 0 },

  "transform": [
    {
      "fold": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"],
      "as": ["State", "Count"]
    },
    { "calculate": "toNumber(datum.Count)", "as": "Count" },
    {
      "joinaggregate": [{ "op": "sum", "field": "Count", "as": "StateTotal" }],
      "groupby": ["State"]
    },
    {
      "calculate": "datum.StateTotal > 0 ? datum.Count / datum.StateTotal * 100 : 0",
      "as": "Percentage"
    },
    {
      "calculate": "format(datum.Percentage, '.1f') + '%'",
      "as": "PercentageLabel"
    },
    {
      "calculate": "indexof(['Support for local environment','Social reasons','Nature conservation','Education or work','Exercise','Other reasons','Enjoyment','Did not know'], datum.Reason)",
      "as": "ReasonOrder"
    },
    {
      "stack": "Percentage",
      "groupby": ["State"],
      "sort": [{ "field": "ReasonOrder", "order": "ascending" }],
      "as": ["y0", "y1"]
    },
    { "calculate": "(datum.y0 + datum.y1) / 2", "as": "yMid" },
    {
      "calculate": "format(datum.Percentage, '.0f') + '%'",
      "as": "SegmentLabel"
    }
  ],

  "encoding": {
    "x": {
      "field": "State",
      "type": "nominal",
      "title": "State / Territory",
      "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"],
      "axis": { "labelAngle": 0, "titleFontSize": 13, "labelFontSize": 12 }
    }
  },

  "layer": [
    {
      "mark": { "type": "bar", "stroke": "white", "strokeWidth": 0.5 },
      "encoding": {
        "y": {
          "field": "y0",
          "type": "quantitative",
          "title": "Share of state participants (%)",
          "scale": { "domain": [0, 100] },
          "axis": {
            "format": ".0f",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "tickCount": 10
          }
        },
        "y2": { "field": "y1" },
        "color": {
          "field": "Reason",
          "type": "nominal",
          "title": "Legend",
          "scale": {
            "domain": [
              "Support for local environment",
              "Social reasons",
              "Nature conservation",
              "Education or work",
              "Exercise",
              "Other reasons",
              "Enjoyment",
              "Did not know"
            ],
            "range": [
              "#3B7A57",
              "#D97941",
              "#6B9AC4",
              "#C65D7B",
              "#8A78B5",
              "#C4A747",
              "#4D9B91",
              "#8C6D5A"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 2,
            "labelLimit": 0,
            "columnPadding": 30,
            "rowPadding": 10,
            "offset": 10
          }
        },
        "tooltip": [
          { "field": "State", "type": "nominal", "title": "State" },
          { "field": "Reason", "type": "nominal", "title": "Reason" },
          { "field": "Count", "type": "quantitative", "title": "Participants", "format": "," },
          { "field": "PercentageLabel", "type": "nominal", "title": "Share of state total" }
        ]
      }
    },
    {
      "transform": [{ "filter": "datum.Percentage >= 7" }],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "align": "center",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "y": { "field": "yMid", "type": "quantitative" },
        "text": { "field": "SegmentLabel", "type": "nominal" }
      }
    }
  ],

  "config": {
    "view": { "stroke": null },
    "axis": { "grid": true, "gridColor": "#eee", "domain": false },
    "legend": { "labelFontSize": 12, "titleFontSize": 13 }
  }
}