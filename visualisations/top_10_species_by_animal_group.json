{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 1050,
  "height": 400,
  "padding": {"top": 20, "left": 10, "right": 10, "bottom": 20},
  "autosize": "pad",

  "title": {
    "text": "Top 5 Species Observed in Each Animal Group",
    "subtitle": "Box size shows the number of observations (the smallest group is enlarged slightly so its label fits)",
    "anchor": "middle",
    "frame": "group",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "subtitleColor": "#555",
    "offset": 25,
    "subtitlePadding": 6
  },

  "signals": [
    {"name": "minGroupShare", "value": 0.04},
    {"name": "maxBoost", "value": 0.85}
  ],

  "data": [
    {
      "name": "raw",
      "url": "datasets/top_5_species_by_animal_group.csv",
      "format": {"type": "csv"},
      "transform": [
        {"type": "formula", "as": "observations", "expr": "toNumber(datum.observations)"}
      ]
    },
    {
      "name": "total",
      "source": "raw",
      "transform": [
        {"type": "aggregate", "fields": ["observations"], "ops": ["sum"], "as": ["obs"]},
        {"type": "formula", "as": "id", "expr": "'All animals'"},
        {"type": "formula", "as": "parent", "expr": "null"},
        {"type": "formula", "as": "label", "expr": "'All animals'"},
        {"type": "formula", "as": "grp", "expr": "'All animals'"},
        {"type": "formula", "as": "size", "expr": "0"}
      ]
    },
    {
      "name": "groups",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["animal_group"],
          "fields": ["observations"],
          "ops": ["sum"],
          "as": ["obs"]
        },
        {"type": "formula", "as": "id", "expr": "datum.animal_group"},
        {"type": "formula", "as": "parent", "expr": "'All animals'"},
        {"type": "formula", "as": "label", "expr": "datum.animal_group"},
        {"type": "formula", "as": "grp", "expr": "datum.animal_group"},
        {"type": "formula", "as": "size", "expr": "0"}
      ]
    },
    {
      "name": "groupRank",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["animal_group"],
          "fields": ["observations"],
          "ops": ["sum"],
          "as": ["obs"]
        },
        {"type": "collect", "sort": {"field": "obs", "order": "ascending"}}
      ]
    },
    {
      "name": "leaves",
      "source": "raw",
      "transform": [
        {
          "type": "joinaggregate",
          "groupby": ["animal_group"],
          "fields": ["observations"],
          "ops": ["sum"],
          "as": ["group_total"]
        },
        {
          "type": "joinaggregate",
          "fields": ["observations"],
          "ops": ["sum"],
          "as": ["grand_total"]
        },
        {"type": "formula", "as": "id", "expr": "datum.animal_group + '/' + datum.common_name"},
        {"type": "formula", "as": "parent", "expr": "datum.animal_group"},
        {"type": "formula", "as": "label", "expr": "datum.common_name"},
        {"type": "formula", "as": "grp", "expr": "datum.animal_group"},
        {"type": "formula", "as": "obs", "expr": "datum.observations"},
        {
          "type": "formula",
          "as": "boost",
          "expr": "length(data('groupRank')) > 1 && datum.group_total === data('groupRank')[0].obs ? max(1, min(minGroupShare * datum.grand_total / datum.group_total, maxBoost * data('groupRank')[1].obs / datum.group_total)) : 1"
        },
        {"type": "formula", "as": "size", "expr": "datum.observations * datum.boost"}
      ]
    },
    {
      "name": "tree",
      "source": ["total", "groups", "leaves"],
      "transform": [
        {"type": "stratify", "key": "id", "parentKey": "parent"},
        {
          "type": "treemap",
          "field": "size",
          "sort": {"field": "value", "order": "descending"},
          "round": true,
          "method": "squarify",
          "ratio": 1.4,
          "paddingInner": 2,
          "paddingOuter": 3,
          "paddingTop": 22,
          "size": [{"signal": "width"}, {"signal": "height"}]
        }
      ]
    },
    {
      "name": "groupNodes",
      "source": "tree",
      "transform": [{"type": "filter", "expr": "datum.depth === 1"}]
    },
    {
      "name": "leafNodes",
      "source": "tree",
      "transform": [{"type": "filter", "expr": "datum.depth === 2"}]
    },
    {
      "name": "leafLabels",
      "source": "leafNodes",
      "transform": [
        {"type": "formula", "as": "lb_w", "expr": "datum.x1 - datum.x0 - 8"},
        {"type": "formula", "as": "lb_h", "expr": "datum.y1 - datum.y0"},
        {"type": "formula", "as": "lb_len", "expr": "length(datum.label)"},
        {
          "type": "formula",
          "as": "lb_n",
          "expr": "max(1, min(3, ceil(datum.lb_len / max(1, floor(datum.lb_w / 5.1))), floor((datum.lb_h - 6) / 13) - 1))"
        },
        {"type": "formula", "as": "lb_t1", "expr": "floor(datum.lb_len / datum.lb_n)"},
        {"type": "formula", "as": "lb_a1", "expr": "lastindexof(substring(datum.label, 0, datum.lb_t1), ' ')"},
        {
          "type": "formula",
          "as": "lb_c1",
          "expr": "indexof(substring(datum.label, datum.lb_t1), ' ') < 0 ? -1 : datum.lb_t1 + indexof(substring(datum.label, datum.lb_t1), ' ')"
        },
        {
          "type": "formula",
          "as": "lb_p1",
          "expr": "datum.lb_n < 2 ? -1 : (datum.lb_a1 < 0 ? datum.lb_c1 : (datum.lb_c1 < 0 ? datum.lb_a1 : (datum.lb_t1 - datum.lb_a1 <= datum.lb_c1 - datum.lb_t1 ? datum.lb_a1 : datum.lb_c1)))"
        },
        {"type": "formula", "as": "lb_t2", "expr": "floor(2 * datum.lb_len / 3)"},
        {"type": "formula", "as": "lb_a2", "expr": "lastindexof(substring(datum.label, 0, datum.lb_t2), ' ')"},
        {
          "type": "formula",
          "as": "lb_c2",
          "expr": "indexof(substring(datum.label, datum.lb_t2), ' ') < 0 ? -1 : datum.lb_t2 + indexof(substring(datum.label, datum.lb_t2), ' ')"
        },
        {
          "type": "formula",
          "as": "lb_p2",
          "expr": "datum.lb_n < 3 ? -1 : (datum.lb_a2 < 0 ? datum.lb_c2 : (datum.lb_c2 < 0 ? datum.lb_a2 : (datum.lb_t2 - datum.lb_a2 <= datum.lb_c2 - datum.lb_t2 ? datum.lb_a2 : datum.lb_c2)))"
        },
        {
          "type": "formula",
          "as": "lb_s0",
          "expr": "datum.lb_p1 < 0 ? datum.label : substring(datum.label, 0, datum.lb_p1)"
        },
        {
          "type": "formula",
          "as": "lb_s1",
          "expr": "datum.lb_p1 < 0 ? '' : (datum.lb_p2 > datum.lb_p1 ? substring(datum.label, datum.lb_p1 + 1, datum.lb_p2) : substring(datum.label, datum.lb_p1 + 1))"
        },
        {
          "type": "formula",
          "as": "lb_s2",
          "expr": "datum.lb_p1 >= 0 && datum.lb_p2 > datum.lb_p1 ? substring(datum.label, datum.lb_p2 + 1) : ''"
        },
        {
          "type": "formula",
          "as": "lb_text",
          "expr": "datum.lb_s2 !== '' ? [datum.lb_s0, datum.lb_s1, datum.lb_s2, format(datum.obs, ',')] : (datum.lb_s1 !== '' ? [datum.lb_s0, datum.lb_s1, format(datum.obs, ',')] : [datum.lb_s0, format(datum.obs, ',')])"
        },
        {"type": "formula", "as": "lb_lines", "expr": "length(datum.lb_text)"},
        {
          "type": "filter",
          "expr": "(datum.x1 - datum.x0) > 58 && datum.lb_h > datum.lb_lines * 13 + 6"
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": ["Amphibians", "Birds", "Fish", "Invertebrates", "Mammals", "Reptiles"],
      "range": {"scheme": "set2"}
    }
  ],

  "legends": [
    {
      "fill": "color",
      "title": "Animal group",
      "orient": "top",
      "direction": "horizontal",
      "columns": 6,
      "titleOrient": "left",
      "titleAnchor": "middle",
      "titlePadding": 12,
      "columnPadding": 18,
      "offset": 10,
      "symbolType": "square",
      "symbolSize": 120,
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  ],

  "marks": [
    {
      "type": "rect",
      "from": {"data": "groupNodes"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": {"scale": "color", "field": "grp"},
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "leafNodes"},
      "encode": {
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": {"scale": "color", "field": "grp"},
          "fillOpacity": {"value": 0.75},
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 1},
          "tooltip": {
            "signal": "{'Species': datum.label, 'Animal group': datum.grp, 'Observations': format(datum.obs, ',')}"
          }
        },
        "hover": {
          "fillOpacity": {"value": 1},
          "stroke": {"value": "#333"},
          "strokeWidth": {"value": 2}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "leafLabels"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "0.5 * (datum.x0 + datum.x1)"},
          "y": {"signal": "0.5 * (datum.y0 + datum.y1) - datum.lb_lines * 13 / 2"},
          "text": {"signal": "datum.lb_text"},
          "align": {"value": "center"},
          "baseline": {"value": "top"},
          "lineHeight": {"value": 13},
          "fontSize": {"value": 10},
          "fill": {"value": "#111"},
          "limit": {"signal": "datum.x1 - datum.x0 - 8"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "groupNodes"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "datum.x0 + 4"},
          "y": {"signal": "datum.y0 + 5"},
          "text": {"signal": "'Total: ' + format(datum.obs, ',')"},
          "align": {"value": "left"},
          "baseline": {"value": "top"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#111"},
          "limit": {"signal": "datum.x1 - datum.x0 + 12"}
        }
      }
    }
  ]
}