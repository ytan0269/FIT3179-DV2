{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Stacked bar chart showing the share of participation in each activity within each Australian state or territory. Each bar sums to 100 percent.",

  "title": {
    "text": "Participation by Activity Across Australian States and Territories",
    "subtitle": "Each bar shows how that state's participants are split across activities (sums to 100%)",
    "anchor": "middle",
    "frame": "bounds",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "offset": 16,
    "subtitlePadding": 6,
    "subtitleColor": "#555"
  },

  "data": {
    "url": "datasets/activity.csv",
    "format": {
      "type": "csv"
    }
  },

  "width": 550,
  "height": 350,
  "padding": {"left": 15, "right": 15, "top": 0, "bottom": 0},
  "transform": [
    {
      "fold": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"],
      "as": ["State", "Count"]
    },
    {
      "calculate": "toNumber(datum.Count)",
      "as": "Count"
    },
    {
      "joinaggregate": [
        { "op": "sum", "field": "Count", "as": "StateTotal" }
      ],
      "groupby": ["State"]
    },
    {
      "calculate": "datum.Count / datum.StateTotal * 100",
      "as": "Percentage"
    },
    {
      "calculate": "format(datum.Percentage, '.1f') + '%'",
      "as": "PercentageLabel"
    }
  ],

  "mark": {
    "type": "bar",
    "stroke": "white",
    "strokeWidth": 0.5
  },

  "encoding": {
    "x": {
      "field": "State",
      "type": "nominal",
      "title": "State / Territory",
      "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"],
      "axis": {
        "labelAngle": 0,
        "titleFontSize": 13,
        "labelFontSize": 12
      }
    },

    "y": {
      "field": "Percentage",
      "type": "quantitative",
      "title": "Share of state participants (%)",
      "scale": { "domain": [0, 100] },
      "axis": {
        "format": ".0f",
        "titleFontSize": 13,
        "labelFontSize": 12,
        "tickCount": 10
      }
    },

    "color": {
      "field": "Activity",
      "type": "nominal",
      "title": "Legend",
      "scale": {
        "range": [
          "#AABB6A",
          "#F8C85E",
          "#E27A55",
          "#98D0EA",
          "#B0A2D2",
          "#8575B5",
          "#4A64A0",
          "#B54D6E"
        ]
      },
      "legend": {
        "orient": "bottom",
        "columns": 2,
        "labelLimit": 0,
        "columnPadding": 30,
        "rowPadding": 10,
        "offset": 10
      }
    },

    "order": {
      "field": "Activity",
      "type": "nominal"
    },

    "tooltip": [
      { "field": "State", "type": "nominal", "title": "State" },
      { "field": "Activity", "type": "nominal", "title": "Activity" },
      { "field": "Count", "type": "quantitative", "title": "Participants", "format": "," },
      { "field": "PercentageLabel", "type": "nominal", "title": "Share of state total" }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": true,
      "gridColor": "#eee",
      "domain": false
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}