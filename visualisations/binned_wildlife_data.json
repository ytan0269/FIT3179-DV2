{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Binned map showing each grid square's share of animal observations across Australia.",

  "width": 820,
  "height": 700,
  "padding": {"left": 20, "right": 20, "top": 20, "bottom": 30},
  "autosize": "pad",
  "background": "#ffffff",

  "title": {
    "text": "Where Animals Are Observed Across Australia",
    "subtitle": {
      "signal": "'Share of ' + (animalGroup === 'All' ? 'all' : lower(animalGroup)) + ' observations falling in each map grid square'"
    },
    "anchor": "middle",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "offset": 16,
    "subtitlePadding": 6,
    "subtitleColor": "#555"
  },

  "signals": [
    {
      "name": "animalGroup",
      "value": "All",
      "on": [{ "events": "@groupBtn:click", "update": "datum.name" }]
    },
    { "name": "legendX", "update": "width + 30" },
    { "name": "legendY", "value": 36 },
    { "name": "legendStep", "value": 28 }
  ],

  "projections": [
    {
      "name": "projection",
      "type": "mercator",
      "center": [133.5, -28],
      "scale": 850,
      "translate": [{ "signal": "width / 2" }, { "signal": "height / 2" }]
    }
  ],

  "scales": [
    {
      "name": "color",
      "type": "threshold",
      "domain": [0.01, 0.1, 1, 5],
      "range": ["#fee5d9", "#fcae91", "#fb6a4a", "#de2d26", "#a50f15"]
    },
    {
      "name": "btnX",
      "type": "band",
      "domain": { "data": "groupList", "field": "name" },
      "range": "width",
      "paddingInner": 0.08,
      "paddingOuter": 0
    }
  ],

  "data": [
    {
      "name": "groupList",
      "values": [
        { "name": "All" },
        { "name": "Amphibians" },
        { "name": "Birds" },
        { "name": "Fish" },
        { "name": "Invertebrates" },
        { "name": "Mammals" },
        { "name": "Reptiles" }
      ]
    },
    {
      "name": "legendSteps",
      "values": [
        { "i": 0, "v": 0.005, "label": "Under 0.01%" },
        { "i": 1, "v": 0.05,  "label": "0.01% to 0.1%" },
        { "i": 2, "v": 0.5,   "label": "0.1% to 1%" },
        { "i": 3, "v": 2,     "label": "1% to 5%" },
        { "i": 4, "v": 10,    "label": "5% or more" }
      ]
    },
    {
      "name": "states",
      "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
      "format": { "type": "json", "property": "features" }
    },
    {
      "name": "oceanLabels",
      "values": [
        { "name": "Indian Ocean",   "lon": 109.5, "lat": -28 },
        { "name": "Southern Ocean", "lon": 128,   "lat": -41.5 },
        { "name": "Pacific Ocean",  "lon": 157,   "lat": -27 },
        { "name": "Tasman Sea",     "lon": 157,   "lat": -38 },
        { "name": "Coral Sea",      "lon": 153.5, "lat": -17 },
        { "name": "Timor Sea",      "lon": 126,   "lat": -12 },
        { "name": "Arafura Sea",    "lon": 135,   "lat": -9.5 }
      ],
      "transform": [
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": ["lon", "lat"],
          "as": ["x", "y"]
        }
      ]
    },
    {
      "name": "rawBinned",
      "url": "datasets/binned_wildlife_data.csv",
      "format": { "type": "csv" },
      "transform": [
        { "type": "formula", "as": "lon_bin",      "expr": "toNumber(datum.lon_bin)" },
        { "type": "formula", "as": "lat_bin",      "expr": "toNumber(datum.lat_bin)" },
        { "type": "formula", "as": "lon_bin_end",  "expr": "toNumber(datum.lon_bin_end)" },
        { "type": "formula", "as": "lat_bin_end",  "expr": "toNumber(datum.lat_bin_end)" },
        { "type": "formula", "as": "observations", "expr": "toNumber(datum.observations)" },
        { "type": "formula", "as": "percentage",   "expr": "toNumber(datum.percentage)" },
        {
          "type": "filter",
          "expr": "isValid(datum.lon_bin) && isValid(datum.lat_bin) && isValid(datum.observations) && isValid(datum.percentage)"
        }
      ]
    },
    {
      "name": "binned",
      "source": "rawBinned",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.animal_group === animalGroup"
        },
        {
          "type": "aggregate",
          "groupby": ["lon_bin", "lat_bin", "lon_bin_end", "lat_bin_end"],
          "fields": ["observations", "percentage"],
          "ops": ["sum", "sum"],
          "as": ["observations", "percentage"]
        },
        { "type": "formula", "as": "animal_group", "expr": "animalGroup" }
      ]
    },
    {
      "name": "bins",
      "source": "binned",
      "transform": [
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": ["lon_bin", "lat_bin"],
          "as": ["x0", "y0"]
        },
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": ["lon_bin_end", "lat_bin_end"],
          "as": ["x1", "y1"]
        },
        { "type": "formula", "as": "x",      "expr": "min(datum.x0, datum.x1)" },
        { "type": "formula", "as": "y",      "expr": "min(datum.y0, datum.y1)" },
        { "type": "formula", "as": "width",  "expr": "abs(datum.x1 - datum.x0)" },
        { "type": "formula", "as": "height", "expr": "abs(datum.y1 - datum.y0)" }
      ]
    }
  ],

  "marks": [
    {
      "name": "ocean",
      "type": "rect",
      "interactive": false,
      "encode": {
        "update": {
          "x": { "value": 0 },
          "x2": { "signal": "width" },
          "y": { "value": 0 },
          "y2": { "signal": "height" },
          "fill": { "value": "#e3eef7" },
          "stroke": { "value": "#b7c9d8" },
          "strokeWidth": { "value": 1 }
        }
      }
    },
    {
      "name": "land",
      "type": "shape",
      "from": { "data": "states" },
      "interactive": false,
      "transform": [{ "type": "geoshape", "projection": "projection" }],
      "encode": {
        "enter": {
          "fill": { "value": "#f3f0e8" },
          "stroke": { "value": null }
        }
      }
    },
    {
      "name": "binRects",
      "type": "rect",
      "from": { "data": "bins" },
      "encode": {
        "update": {
          "x": { "field": "x" },
          "y": { "field": "y" },
          "width": { "field": "width" },
          "height": { "field": "height" },
          "fill": { "scale": "color", "field": "percentage" },
          "fillOpacity": { "value": 0.8 },
          "stroke": { "value": null },
          "strokeWidth": { "value": 0 },
          "tooltip": {
            "signal": "{'Animal group': datum.animal_group, 'Longitude': format(datum.lon_bin, '.2f') + '° to ' + format(datum.lon_bin_end, '.2f') + '°', 'Latitude': format(datum.lat_bin, '.2f') + '° to ' + format(datum.lat_bin_end, '.2f') + '°', 'Share of observations': format(datum.percentage, '.2r') + '%', 'Observations': format(datum.observations, ',')}"
          }
        },
        "hover": {
          "fillOpacity": { "value": 1 },
          "stroke": { "value": "black" },
          "strokeWidth": { "value": 1 }
        }
      }
    },
    {
      "name": "stateBorders",
      "type": "shape",
      "from": { "data": "states" },
      "interactive": false,
      "transform": [{ "type": "geoshape", "projection": "projection" }],
      "encode": {
        "enter": {
          "fill": { "value": null },
          "stroke": { "value": "black" },
          "strokeWidth": { "value": 0.75 },
          "strokeJoin": { "value": "round" }
        }
      }
    },
    {
      "name": "oceanNames",
      "type": "text",
      "from": { "data": "oceanLabels" },
      "interactive": false,
      "encode": {
        "update": {
          "x": { "field": "x" },
          "y": { "field": "y" },
          "text": { "field": "name" },
          "align": { "value": "center" },
          "baseline": { "value": "middle" },
          "fontStyle": { "value": "italic" },
          "fontSize": { "value": 13 },
          "fill": { "value": "#4f7ca3" }
        }
      }
    },

    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": { "signal": "legendX" },
          "y": { "value": 10 },
          "text": { "value": "Share of observations" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 13 },
          "fontWeight": { "value": "bold" },
          "fill": { "value": "#222222" }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": { "signal": "legendX" },
          "y": { "value": 25 },
          "text": { "value": "per grid square" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 11 },
          "fill": { "value": "#666666" }
        }
      }
    },
    {
      "type": "rect",
      "from": { "data": "legendSteps" },
      "interactive": false,
      "encode": {
        "update": {
          "x": { "signal": "legendX" },
          "width": { "value": 22 },
          "y": { "signal": "legendY + datum.i * legendStep" },
          "height": { "signal": "legendStep - 4" },
          "cornerRadius": { "value": 3 },
          "fill": { "scale": "color", "field": "v" },
          "fillOpacity": { "value": 0.8 },
          "stroke": { "value": "#999999" },
          "strokeWidth": { "value": 0.5 }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "legendSteps" },
      "interactive": false,
      "encode": {
        "update": {
          "x": { "signal": "legendX + 32" },
          "y": { "signal": "legendY + datum.i * legendStep + (legendStep - 4) / 2" },
          "text": { "field": "label" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 12 },
          "fill": { "value": "#333333" }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": { "signal": "legendX" },
          "y": { "signal": "legendY + 5 * legendStep + 8" },
          "text": { "signal": "'of ' + (animalGroup === 'All' ? 'all' : lower(animalGroup)) + ' records'" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 11 },
          "fontStyle": { "value": "italic" },
          "fill": { "value": "#666666" }
        }
      }
    },

    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": { "value": 0 },
          "y": { "value": -56 },
          "text": { "value": "Filter by animal group:" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 11 },
          "fill": { "value": "#666666" }
        }
      }
    },
    {
      "name": "groupBtn",
      "type": "rect",
      "from": { "data": "groupList" },
      "encode": {
        "update": {
          "x": { "scale": "btnX", "field": "name" },
          "width": { "scale": "btnX", "band": 1 },
          "y": { "value": -46 },
          "height": { "value": 26 },
          "cornerRadius": { "value": 5 },
          "fill": { "signal": "datum.name === animalGroup ? '#333333' : '#eef0f3'" },
          "stroke": { "signal": "datum.name === animalGroup ? '#333333' : '#d5d9de'" },
          "cursor": { "value": "pointer" }
        },
        "hover": {
          "fill": { "signal": "datum.name === animalGroup ? '#333333' : '#dde1e6'" }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "groupList" },
      "interactive": false,
      "encode": {
        "update": {
          "x": { "scale": "btnX", "field": "name", "band": 0.5 },
          "y": { "value": -33 },
          "text": { "field": "name" },
          "align": { "value": "center" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 11 },
          "limit": { "signal": "bandwidth('btnX') - 6" },
          "fill": { "signal": "datum.name === animalGroup ? '#ffffff' : '#333333'" }
        }
      }
    }
  ]
}