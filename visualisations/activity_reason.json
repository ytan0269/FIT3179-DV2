{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "height": 350,
  "width": 820,
  "padding": 20,
  "autosize": {"type": "pad", "contains": "padding"},

  "signals": [
    {
      "name": "reasonOrder",
      "value": [
        "Support for local environment",
        "Social reasons",
        "Nature conservation",
        "Education or work",
        "Exercise",
        "Other reasons",
        "Enjoyment",
        "Did not know"
      ]
    },
    {
      "name": "stateOrder",
      "value": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"]
    }
  ],

  "title": {
    "text": "Why Australians Take Part in Nature Activities, by State and Territory",
    "subtitle": "Share of each state or territory's participants giving each reason",
    "anchor": "middle",
    "frame": "bounds",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "offset": 16,
    "subtitlePadding": 6,
    "subtitleColor": "#555"
  },

  "data": [
    {
      "name": "cells",
      "url": "datasets/activity_reason.csv",
      "format": {"type": "csv"},
      "transform": [
        {
          "type": "fold",
          "fields": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "NT", "ACT"],
          "as": ["state", "size"]
        },
        {
          "type": "formula",
          "expr": "toNumber(datum.size)",
          "as": "size"
        },
        {
          "type": "formula",
          "expr": "{'NSW': 'New South Wales', 'VIC': 'Victoria', 'QLD': 'Queensland', 'SA': 'South Australia', 'WA': 'Western Australia', 'TAS': 'Tasmania', 'NT': 'Northern Territory', 'ACT': 'Australian Capital Territory'}[datum.state]",
          "as": "stateName"
        },
        {
          "type": "joinaggregate",
          "groupby": ["state"],
          "fields": ["size"],
          "ops": ["sum"],
          "as": ["stateTotal"]
        },
        {
          "type": "formula",
          "expr": "datum.stateTotal > 0 ? datum.size / datum.stateTotal : 0",
          "as": "pct"
        }
      ]
    },
    {
      "name": "stats",
      "source": "cells",
      "transform": [
        {
          "type": "aggregate",
          "fields": ["pct"],
          "ops": ["max"],
          "as": ["maxPct"]
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {"signal": "stateOrder"},
      "range": "width",
      "paddingInner": 0.05,
      "paddingOuter": 0
    },
    {
      "name": "y",
      "type": "band",
      "domain": {"signal": "reasonOrder"},
      "range": "height",
      "paddingInner": 0.05,
      "paddingOuter": 0
    },
    {
      "name": "color",
      "type": "linear",
      "domain": {"data": "cells", "field": "pct"},
      "range": {"scheme": "blues"},
      "zero": true,
      "nice": true
    }
  ],

  "axes": [
    {
      "orient": "top",
      "scale": "x",
      "domain": false,
      "ticks": false,
      "labelFontSize": 13,
      "labelFontWeight": "bold",
      "labelPadding": 6
    },
    {
      "orient": "left",
      "scale": "y",
      "domain": false,
      "ticks": false,
      "labelFontSize": 13,
      "labelFontWeight": "bold",
      "labelPadding": 8,
      "labelLimit": 220,
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "datum.value == 'Support for local environment' ? ['Support for local', 'environment'] : datum.value"
            },
            "lineHeight": {"value": 15}
          }
        }
      }
    }
  ],

  "legends": [
    {
      "fill": "color",
      "type": "gradient",
      "orient": "right",
      "title": "Share of state",
      "titleFontSize": 12,
      "labelFontSize": 11,
      "format": ".0%",
      "gradientLength": 200,
      "gradientThickness": 14
    }
  ],

  "marks": [
    {
      "type": "rect",
      "name": "cellMark",
      "from": {"data": "cells"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "state"},
          "width": {"scale": "x", "band": 1},
          "y": {"scale": "y", "field": "Reason"},
          "height": {"scale": "y", "band": 1},
          "fill": {"scale": "color", "field": "pct"},
          "stroke": {"value": "transparent"},
          "strokeWidth": {"value": 2},
          "tooltip": {
            "signal": "{'State': datum.stateName, 'Reason': datum.Reason, 'Participants': format(datum.size, ',.0f'), 'Share of state': format(datum.pct, '.1%')}"
          }
        },
        "hover": {
          "stroke": {"value": "#222"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "cells"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "scale('x', datum.state) + bandwidth('x') / 2"},
          "y": {"signal": "scale('y', datum.Reason) + bandwidth('y') / 2"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fontSize": {"value": 12},
          "text": {"signal": "format(datum.pct, '.1%')"},
          "fill": {
            "signal": "datum.pct > data('stats')[0].maxPct * 0.55 ? '#fff' : '#222'"
          }
        }
      }
    }
  ]
}